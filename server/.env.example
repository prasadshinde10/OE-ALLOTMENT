# Server Environment Configuration (.env)
# Mandatory for Production EC2 Deployment

# Database Connection
MONGO_URI=mongodb://localhost:27017/oe_allotment

# Application Security
# Set a strong, unique 32+ character random secret in production
JWT_SECRET=your_strong_jwt_secret_key_here

# Main OE Admin Credentials
ADMIN_EMAIL=admin@mit.asia
ADMIN_PASSWORD=your_strong_admin_password_here

# First-Year Club Admin Credentials
ADMIN2_EMAIL=admin2@mit.asia
ADMIN2_PASSWORD=your_strong_admin2_password_here

# Email / OTP Service (Gmail / Resend)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
RESEND_API_KEY=your_resend_api_key_optional
OTP_EXPIRY_MINUTES=5
ALLOWED_EMAIL_DOMAIN=mit.asia

# Server & Network Configuration
PORT=5000
CLIENT_URL=http://localhost:3000
NODE_ENV=production

# Microsoft Entra ID (Azure AD) SSO (Optional)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
REDIRECT_URI=
